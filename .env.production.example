# ─── Production — salin ke .env di server hosting ───
# cp .env.production.example .env && php artisan key:generate

APP_NAME=LaksanaTech
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://laksanatech.id

APP_BRAND_NAME=laksanatech
APP_COMPANY_NAME="CV. Laksana Solution"
APP_COMPANY_EMAIL=laksanasolution@gmail.com
APP_COMPANY_PHONE=085212455505
APP_COMPANY_WHATSAPP=6285212455505

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# ─── Database (MySQL di hosting) ───
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laksanatech
DB_USERNAME=
DB_PASSWORD=

# ─── Session & cache (shared hosting: database; VPS: redis) ───
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Redis (opsional — VPS / Cloud)
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# SESSION_DRIVER=redis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# ─── Email transaksional ───
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=laksanasolution@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_NOTIFY_EMAIL=laksanasolution@gmail.com

# ─── Pembayaran ───
PAYMENT_DEFAULT_GATEWAY=midtrans
PAYMENT_CURRENCY=IDR
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# ─── Lainnya ───
BROADCAST_CONNECTION=log
VITE_APP_NAME="${APP_NAME}"
